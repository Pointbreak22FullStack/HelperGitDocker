# Скопируйте в .env (он не попадает в git) и заполните.
# docker compose читает .env из этой папки автоматически.

# Пароль пользователя webparser в PostgreSQL
POSTGRES_PASSWORD=

# Ключ AES-256 для шифрования паролей аккаунтов и прокси в БД (Base64, 32 байта).
# Сгенерировать: openssl rand -base64 32
# ВАЖНО: сохраните ключ. Если его потерять или поменять, сохранённые пароли не расшифруются.
ENCRYPTION_KEY=

# Секрет для приёма SMS-кодов (POST /api/code, заголовок X-Webhook-Secret).
# Пусто = приём кодов отключён. Сгенерировать: openssl rand -hex 24
CODE_WEBHOOK_SECRET=
