# ── REAL PRODUCTION (copy to .env.prod and fill in) ──────────────────────────
# Run: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d

# Identity server public URL
IDENTITY_ISSUER=https://id.webparser.com

# JWT authority (must match IDENTITY_ISSUER + trailing slash)
AUTH_AUTHORITY=https://id.webparser.com/

# Angular OAuth2 redirect URIs (comma-separated)
ALLOWED_REDIRECT_URIS=https://webparser.com/auth/callback
ALLOWED_LOGOUT_URIS=https://webparser.com/login

# Frontend origin allowed by API CORS
CLIENT_ORIGIN=https://webparser.com

# Database password and secrets (generate new ones for production!)
# openssl rand -base64 32  /  openssl rand -hex 24
POSTGRES_PASSWORD=
ENCRYPTION_KEY=
CODE_WEBHOOK_SECRET=

# Angular build: "production" for real domain, "prod-local" for localhost testing
CLIENT_BUILD_CONFIG=production

# SSL: put fullchain.pem and privkey.pem in ./nginx/ssl/
# certbot certonly --standalone -d webparser.com -d api.webparser.com -d id.webparser.com
